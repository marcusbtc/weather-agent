# Copie para .env na raiz do repo e preencha. O .env é gitignored (AC-09).
OPENAI_API_KEY=sk-...

# Opcional. Padrão: gpt-5.4-mini
# OPENAI_MODEL=gpt-5.4-mini

# Opcional. Para usar um provedor compatível com a API da OpenAI (ex.: OpenRouter),
# aponte o endpoint e use o id do modelo no formato do provedor:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-5.4-mini

# Opcional. Fonte da tool get_weather. Padrão: stub (o do enunciado: sem HTTP, 22°C fixo).
# `live` consulta o clima real via Open-Meteo (sem chave) — fora do escopo do enunciado.
# WEATHER_SOURCE=stub
