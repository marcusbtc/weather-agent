# Copy to .env at the repo root and fill in. .env is gitignored (AC-09).
# Without OPENAI_API_KEY the agent uses a deterministic fake chat model (no LLM) — graph,
# tool and stream stay real. Good for demos without a key.
OPENAI_API_KEY=sk-...

# Optional. `fake` forces the fake model even when a key is set.
# MODEL_SOURCE=fake

# Optional. Default: gpt-5.4-mini
# OPENAI_MODEL=gpt-5.4-mini

# Optional. To use an OpenAI-compatible provider (e.g. OpenRouter), point at its endpoint
# and use the provider's model id:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-5.4-mini

# Optional. Source for the get_weather tool. Default: stub (the exercise's: no HTTP, fixed
# 22°C). `live` fetches real weather from Open-Meteo (no key) — outside the exercise's scope.
# WEATHER_SOURCE=stub
